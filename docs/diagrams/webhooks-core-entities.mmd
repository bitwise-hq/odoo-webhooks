erDiagram
  WEBHOOK_HANDLER {
    string code
    string name
    string direction
    string execution_mode
  }
  INBOUND_ENDPOINT {
    string code
    string name
    string path
    reference connector_backend_ref
  }
  INBOUND_EVENT {
    string state
    string delivery_identity_key
    string replay_identity_key
  }
  INBOUND_HANDLER_RULE {
    int sequence
    string action
    string condition_field
  }
  OUTBOUND_ENDPOINT {
    string code
    string target_path
    reference connector_backend_ref
  }
  OUTBOUND_DELIVERY {
    string state
    datetime next_retry_at
    string operation
  }
  OUTBOUND_HANDLER_RULE {
    int sequence
    string action
    string condition_field
  }
  OUTBOUND_ATTEMPT {
    int status_code
    datetime sent_at
    string error_type
  }

  WEBHOOK_HANDLER ||--o{ INBOUND_ENDPOINT : handles
  WEBHOOK_HANDLER ||--o{ OUTBOUND_ENDPOINT : handles
  WEBHOOK_HANDLER ||--o{ INBOUND_HANDLER_RULE : inbound_rules
  WEBHOOK_HANDLER ||--o{ OUTBOUND_HANDLER_RULE : outbound_rules
  INBOUND_ENDPOINT ||--o{ INBOUND_EVENT : receives
  OUTBOUND_ENDPOINT ||--o{ OUTBOUND_DELIVERY : sends
  OUTBOUND_DELIVERY ||--o{ OUTBOUND_ATTEMPT : attempts
