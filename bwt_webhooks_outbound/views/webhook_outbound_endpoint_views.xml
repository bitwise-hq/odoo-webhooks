<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_webhook_outbound_endpoint_search" model="ir.ui.view">
    <field name="name">webhook.outbound.endpoint.search</field>
    <field name="model">bwt.webhook.outbound.endpoint</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="code" />
        <field name="state" />
        <field name="company_id" />
        <field name="handler_id" />
        <field name="http_method" />
        <field name="request_body_mode" />
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
        <filter name="active" string="Active" domain="[('state', '=', 'active')]" />
        <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]" />
        <separator />
        <filter name="group_by_company" string="By Company" context="{'group_by':'company_id'}" />
        <filter name="group_by_handler" string="By Handler" context="{'group_by':'handler_id'}" />
        <filter name="group_by_status" string="By Status" context="{'group_by':'state'}" />
      </search>
    </field>
  </record>

  <record id="view_webhook_outbound_endpoint_list" model="ir.ui.view">
    <field name="name">webhook.outbound.endpoint.list</field>
    <field name="model">bwt.webhook.outbound.endpoint</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="code" />
        <field name="state" />
        <field name="company_id" />
        <field name="http_method" />
        <field name="request_body_mode" />
        <field name="target_hostname" />
        <field name="target_path" />
        <field name="outbound_delivery_count" string="Deliveries" />
        <field name="failed_delivery_count" string="Failures" />
      </tree>
    </field>
  </record>

  <record id="view_webhook_outbound_endpoint_form" model="ir.ui.view">
    <field name="name">webhook.outbound.endpoint.form</field>
    <field name="model">bwt.webhook.outbound.endpoint</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_activate" type="object" string="Activate" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" />
          <button name="action_set_draft" type="object" string="Move To Draft" attrs="{'invisible': [('state', 'not in', ['active', 'archived'])]}" />
          <button name="action_archive" type="object" string="Archive" attrs="{'invisible': [('state', '=', 'archived')]}" />
          <field name="state" widget="statusbar" statusbar_visible="draft,active" options="{'clickable': 0}" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object" name="action_view_outbound_deliveries" icon="fa-cloud-upload">
              <field name="outbound_delivery_count" widget="statinfo" string="Deliveries" />
            </button>
            <button class="oe_stat_button" type="object" name="action_view_failed_outbound_deliveries" icon="fa-exclamation-triangle">
              <field name="failed_delivery_count" widget="statinfo" string="Failures" />
            </button>
          </div>
          <group string="Endpoint">
            <group>
              <field name="name" />
              <field name="code" />
            </group>
            <group>
              <field name="http_method" />
              <field name="request_body_mode" />
              <field name="target_hostname" placeholder="https://api.example.com" />
              <field name="target_path" placeholder="/webhooks/orders" />
              <field name="target_url" widget="url" readonly="1" />
              <field name="timeout_seconds" />
              <field name="handler_id" />
            </group>
          </group>
          <group string="Scope">
            <group>
              <field name="company_id" />
            </group>
          </group>
          <group string="Internal Notes">
            <field name="note" />
          </group>
          <notebook>
            <page string="Header Rules">
              <field name="header_rule_ids" nolabel="1" context="{'default_endpoint_id': id}">
                <tree editable="bottom">
                  <field name="sequence" />
                  <field name="active" />
                  <field name="header_name" />
                  <field name="source_kind" />
                  <field name="source_expression" />
                  <field name="literal_value" />
                </tree>
                <form>
                  <sheet>
                    <group>
                      <group>
                        <field name="sequence" />
                        <field name="active" />
                        <field name="header_name" />
                      </group>
                      <group>
                        <field name="source_kind" />
                        <field name="source_expression" attrs="{'invisible': [('source_kind', '=', 'literal')]}" />
                        <field name="literal_value" attrs="{'invisible': [('source_kind', '!=', 'literal')]}" widget="text" />
                      </group>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Payload Rules">
              <field name="payload_rule_ids" nolabel="1" context="{'default_endpoint_id': id}">
                <tree editable="bottom">
                  <field name="sequence" />
                  <field name="active" />
                  <field name="target_path" />
                  <field name="source_kind" />
                  <field name="source_expression" />
                  <field name="literal_value" />
                </tree>
                <form>
                  <sheet>
                    <group>
                      <group>
                        <field name="sequence" />
                        <field name="active" />
                        <field name="target_path" />
                      </group>
                      <group>
                        <field name="source_kind" />
                        <field name="source_expression" attrs="{'invisible': [('source_kind', '=', 'literal')]}" />
                        <field name="literal_value" attrs="{'invisible': [('source_kind', '!=', 'literal')]}" widget="text" />
                      </group>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Deliveries">
              <field name="outbound_delivery_ids" readonly="1">
                <tree>
                  <field name="create_date" string="Created" />
                  <field name="state" />
                  <field name="response_status_code" />
                  <field name="processed_at" />
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <record id="action_webhook_outbound_endpoint" model="ir.actions.act_window">
    <field name="name">Outbound Webhook Endpoints</field>
    <field name="res_model">bwt.webhook.outbound.endpoint</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_webhook_outbound_endpoint_search" />
  </record>
</odoo>
