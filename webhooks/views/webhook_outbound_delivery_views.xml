<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_webhook_outbound_delivery_search" model="ir.ui.view">
        <field name="name">webhook.outbound.delivery.search</field>
        <field name="model">webhook.outbound.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="endpoint_id"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="handler_id"/>
                <field name="state"/>
                <field name="response_status_code"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="error" string="Error" domain="[('state', '=', 'error')]"/>
                <filter name="dead_letter" string="Dead Letter" domain="[('state', '=', 'dead_letter')]"/>
            </search>
        </field>
    </record>

    <record id="view_webhook_outbound_delivery_list" model="ir.ui.view">
        <field name="name">webhook.outbound.delivery.list</field>
        <field name="model">webhook.outbound.delivery</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Created"/>
                <field name="endpoint_id"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="response_status_code"/>
                <field name="queued_at"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_outbound_delivery_form" model="ir.ui.view">
        <field name="name">webhook.outbound.delivery.form</field>
        <field name="model">webhook.outbound.delivery</field>
        <field name="arch" type="xml">
            <form delete="false">
                <header>
                    <button name="action_queue_delivery" type="object" string="Queue Delivery" invisible="state not in ['draft', 'error']"/>
                    <button name="action_reset_to_draft" type="object" string="Reset To Draft" invisible="state not in ['error', 'dead_letter', 'canceled']"/>
                    <button name="action_cancel_delivery" type="object" string="Cancel" invisible="state not in ['draft', 'error']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,processing,done,error,dead_letter,canceled"/>
                </header>
                <sheet>
                    <group string="Operator Guidance" invisible="not operator_action_hint">
                        <field name="operator_action_hint" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <group string="Context">
                        <group>
                            <field name="name"/>
                            <field name="endpoint_id"/>
                            <field name="company_id"/>
                            <field name="partner_id" placeholder="Inherited from endpoint when set"/>
                            <field name="execution_user_id"/>
                            <field name="handler_id"/>
                        </group>
                        <group>
                            <field name="http_method"/>
                            <field name="target_url" widget="url"/>
                            <field name="timeout_seconds"/>
                            <field name="queued_at"/>
                            <field name="processed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <group string="Headers">
                                <field name="request_headers_json" widget="text" nolabel="1"/>
                            </group>
                            <group string="Payload">
                                <field name="payload_json" widget="text" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Response">
                            <group>
                                <field name="response_status_code"/>
                                <field name="response_headers_json" widget="text"/>
                                <field name="response_body" widget="text"/>
                            </group>
                        </page>
                        <page string="Processing">
                            <group>
                                <field name="processing_note" readonly="1"/>
                                <field name="processing_error" readonly="1"/>
                                <field name="queue_job_identity_key" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webhook_outbound_delivery" model="ir.actions.act_window">
        <field name="name">Outbound Webhook Deliveries</field>
        <field name="res_model">webhook.outbound.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_webhook_outbound_delivery_search"/>
    </record>

</odoo>