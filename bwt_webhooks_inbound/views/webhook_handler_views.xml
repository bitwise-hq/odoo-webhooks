<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_webhook_handler_form_inbound" model="ir.ui.view">
    <field name="name">webhook.handler.form.inbound</field>
    <field name="model">bwt.webhook.handler</field>
    <field name="inherit_id" ref="bwt_webhooks_core.view_webhook_handler_form" />
    <field name="arch" type="xml">
      <notebook name="rules" position="inside">
        <page string="Inbound Rules" invisible="direction != 'inbound'">
          <field name="inbound_rule_ids" nolabel="1" context="{'default_handler_id': id}">
            <tree editable="bottom">
              <field name="sequence" />
              <field name="active" />
              <field name="name" />
              <field name="action_type" />
              <field name="target_model_name" />
              <field name="retry_seconds" />
            </tree>
            <form>
              <sheet>
                <group>
                  <group>
                    <field name="name" />
                    <field name="sequence" />
                    <field name="active" />
                    <field name="action_type" />
                  </group>
                  <group>
                    <field name="target_model_name" invisible="action_type not in ['create_record', 'update_record', 'upsert_record']" />
                    <field name="retry_seconds" invisible="action_type != 'retry'" />
                  </group>
                </group>
                <group string="Notes">
                  <field name="note" nolabel="1" widget="text" />
                </group>
                <notebook>
                  <page string="Conditions">
                    <field name="condition_ids" nolabel="1">
                      <tree editable="bottom">
                        <field name="sequence" />
                        <field name="source_kind" />
                        <field name="source_expression" />
                        <field name="operator" />
                        <field name="expected_value" />
                      </tree>
                    </field>
                  </page>
                  <page string="Lookup Keys" invisible="action_type not in ['update_record', 'upsert_record']">
                    <field name="lookup_ids" nolabel="1">
                      <tree editable="bottom">
                        <field name="sequence" />
                        <field name="target_field_name" />
                        <field name="source_kind" />
                        <field name="source_expression" />
                        <field name="literal_value" />
                      </tree>
                    </field>
                  </page>
                  <page string="Assignments" invisible="action_type not in ['create_record', 'update_record', 'upsert_record']">
                    <field name="assignment_ids" nolabel="1">
                      <tree editable="bottom">
                        <field name="sequence" />
                        <field name="target_kind" />
                        <field name="target_expression" />
                        <field name="source_kind" />
                        <field name="source_expression" />
                        <field name="literal_value" />
                      </tree>
                    </field>
                  </page>
                  <page string="Executions">
                    <field name="execution_ids" nolabel="1" readonly="1">
                      <tree>
                        <field name="create_date" string="Executed" />
                        <field name="event_id" />
                        <field name="state" />
                        <field name="record_reference" />
                        <field name="note" />
                      </tree>
                    </field>
                  </page>
                </notebook>
              </sheet>
            </form>
          </field>
        </page>
      </notebook>
    </field>
  </record>
</odoo>
