<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_webhook_outbound_endpoint_search" model="ir.ui.view">
        <field name="name">webhook.outbound.endpoint.search</field>
        <field name="model">webhook.outbound.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="handler_id"/>
                <field name="http_method"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="paused" string="Paused" domain="[('is_paused', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_webhook_outbound_endpoint_list" model="ir.ui.view">
        <field name="name">webhook.outbound.endpoint.list</field>
        <field name="model">webhook.outbound.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="operational_state"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="http_method"/>
                <field name="target_url"/>
                <field name="outbound_delivery_count" string="Deliveries"/>
                <field name="failed_delivery_count" string="Failures"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_outbound_endpoint_form" model="ir.ui.view">
        <field name="name">webhook.outbound.endpoint.form</field>
        <field name="model">webhook.outbound.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="execution_user_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_outbound_deliveries" icon="fa-cloud-upload">
                            <field name="outbound_delivery_count" widget="statinfo" string="Deliveries"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_failed_outbound_deliveries" icon="fa-exclamation-triangle">
                            <field name="failed_delivery_count" widget="statinfo" string="Failures"/>
                        </button>
                    </div>
                    <group string="Endpoint">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="operational_state" readonly="1"/>
                            <field name="active"/>
                            <field name="is_paused"/>
                        </group>
                        <group>
                            <field name="http_method"/>
                            <field name="target_url" widget="url"/>
                            <field name="timeout_seconds"/>
                            <field name="handler_id"/>
                        </group>
                    </group>
                    <group string="Scope">
                        <group>
                            <field name="company_id"/>
                            <field name="partner_id" placeholder="Company-scoped only"/>
                        </group>
                    </group>
                    <group string="Internal Notes">
                        <field name="note"/>
                    </group>
                    <notebook>
                        <page string="Header Rules">
                            <field name="header_rule_ids" nolabel="1" context="{'default_endpoint_id': id}">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="active"/>
                                    <field name="header_name"/>
                                    <field name="source_kind"/>
                                    <field name="source_expression"/>
                                    <field name="literal_value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payload Rules">
                            <field name="payload_rule_ids" nolabel="1" context="{'default_endpoint_id': id}">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="active"/>
                                    <field name="target_path"/>
                                    <field name="source_kind"/>
                                    <field name="source_expression"/>
                                    <field name="literal_value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Deliveries">
                            <field name="outbound_delivery_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Created"/>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                    <field name="response_status_code"/>
                                    <field name="processed_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_webhook_outbound_endpoint" model="ir.actions.act_window">
        <field name="name">Outbound Webhook Endpoints</field>
        <field name="res_model">webhook.outbound.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_webhook_outbound_endpoint_search"/>
    </record>

</odoo>