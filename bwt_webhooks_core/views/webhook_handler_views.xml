<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_webhook_handler_search" model="ir.ui.view">
    <field name="name">webhook.handler.search</field>
    <field name="model">bwt.webhook.handler</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="code" />
        <field name="execution_mode" />
        <field name="direction" />
        <field name="company_id" />
        <filter name="active" string="Active" domain="[('active', '=', True)]" />
        <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
      </search>
    </field>
  </record>

  <record id="view_webhook_handler_list" model="ir.ui.view">
    <field name="name">webhook.handler.list</field>
    <field name="model">bwt.webhook.handler</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="code" />
        <field name="direction" />
        <field name="execution_mode" />
        <field name="company_id" />
        <field name="active" />
      </tree>
    </field>
  </record>

  <record id="view_webhook_handler_form" model="ir.ui.view">
    <field name="name">webhook.handler.form</field>
    <field name="model">bwt.webhook.handler</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group string="Handler">
            <group>
              <field name="name" />
              <field name="code" />
              <field name="active" />
            </group>
            <group>
              <field name="direction" />
              <field name="execution_mode" />
            </group>
          </group>
          <group string="Scope">
            <group>
              <field name="company_id" />
            </group>
          </group>
          <group string="Python Callback" attrs="{'invisible': [('execution_mode', '!=', 'python')]}">
            <field name="python_model_name" />
            <field name="python_method_name" />
          </group>
          <notebook name="rules" attrs="{'invisible': [('execution_mode', '!=', 'model_driven')]}" />
          <group string="Internal Notes">
            <field name="note" />
          </group>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids" />
          <field name="activity_ids" />
          <field name="message_ids" />
        </div>
      </form>
    </field>
  </record>

  <record id="action_webhook_handler" model="ir.actions.act_window">
    <field name="name">Webhook Handlers</field>
    <field name="res_model">bwt.webhook.handler</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
