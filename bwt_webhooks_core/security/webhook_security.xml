<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <data noupdate="1">
    <record id="webhook_handler_company_rule" model="ir.rule">
      <field name="name">Webhook Handler multi-company</field>
      <field name="model_id" ref="model_bwt_webhook_handler" />
      <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="queue_job_webhook_operator_rule" model="ir.rule">
      <field name="name">Webhook Queue Job operator scope</field>
      <field name="model_id" ref="queue_job.model_queue_job" />
      <field name="groups" eval="[(4, ref('bwt_webhooks_core.group_webhooks_operator'))]" />
      <field name="domain_force">[
                '&amp;',
                '|', ('company_id', '=', False), ('company_id', 'in', company_ids),
                '|',
                '&amp;', ('model_name', '=', 'bwt.webhook.inbound.event'), ('method_name', '=', 'process_event'),
                '&amp;', ('model_name', '=', 'bwt.webhook.outbound.delivery'), ('method_name', '=', 'process_delivery')
            ]</field>
    </record>

    <record id="queue_job_webhook_admin_rule" model="ir.rule">
      <field name="name">Webhook Queue Job admin scope</field>
      <field name="model_id" ref="queue_job.model_queue_job" />
      <field name="groups" eval="[(4, ref('bwt_webhooks_core.group_webhooks_admin'))]" />
      <field name="domain_force">[
                '&amp;',
                '|', ('company_id', '=', False), ('company_id', 'in', company_ids),
                '|',
                '&amp;', ('model_name', '=', 'bwt.webhook.inbound.event'), ('method_name', '=', 'process_event'),
                '&amp;', ('model_name', '=', 'bwt.webhook.outbound.delivery'), ('method_name', '=', 'process_delivery')
            ]</field>
    </record>
  </data>
</odoo>
