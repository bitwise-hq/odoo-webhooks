<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_webhook_handler_search" model="ir.ui.view">
        <field name="name">webhook.handler.search</field>
        <field name="model">webhook.handler</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="execution_mode"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_webhook_handler_list" model="ir.ui.view">
        <field name="name">webhook.handler.list</field>
        <field name="model">webhook.handler</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="execution_mode"/>
                <field name="inbound_enabled"/>
                <field name="outbound_enabled"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_handler_form" model="ir.ui.view">
        <field name="name">webhook.handler.form</field>
        <field name="model">webhook.handler</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Handler">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="execution_mode"/>
                            <field name="inbound_enabled"/>
                            <field name="outbound_enabled"/>
                        </group>
                    </group>
                    <group string="Configuration Guidance" invisible="not configuration_warning">
                        <field name="configuration_warning" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <group string="Low-Code Configuration" invisible="execution_mode != 'low_code'">
                        <field name="low_code_config_json" widget="text" nolabel="1"/>
                    </group>
                    <group string="Python Callback" invisible="execution_mode != 'python'">
                        <field name="python_model_name"/>
                        <field name="python_method_name"/>
                    </group>
                    <group string="Internal Notes">
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webhook_handler" model="ir.actions.act_window">
        <field name="name">Webhook Handlers</field>
        <field name="res_model">webhook.handler</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_webhook_handler_search"/>
    </record>

</odoo>