<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_webhook_outbound_delivery_search" model="ir.ui.view">
    <field name="name">webhook.outbound.delivery.search</field>
    <field name="model">bwt.webhook.outbound.delivery</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="create_date" />
        <field name="processed_at" />
        <field name="endpoint_id" />
        <field name="company_id" />
        <field name="handler_id" />
        <field name="state" />
        <field name="request_body_mode" />
        <field name="response_status_code" />
        <filter name="not_done" string="Not Done" domain="[('state', '!=', 'done')]" />
        <filter name="needs_attention" string="Needs Attention" domain="[('state', 'in', ('error', 'dead_letter'))]" />
        <filter name="http_error" string="HTTP Error (4xx/5xx)" domain="[('response_status_code', '&gt;=', 400)]" />
        <filter name="last_24_hours" string="Last 24 Hours" domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]" />
        <filter name="today" string="Today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]" />
        <filter name="last_7_days" string="Last 7 Days" domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]" />
        <filter name="slow_delivery" string="Slow Delivery (&gt;5m)" domain="[('queue_to_done_seconds', '&gt;', 300)]" />
        <separator />
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
        <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]" />
        <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
        <filter name="error" string="Error" domain="[('state', '=', 'error')]" />
        <filter name="dead_letter" string="Dead Letter" domain="[('state', '=', 'dead_letter')]" />
        <separator />
        <filter name="group_by_endpoint" string="By Endpoint" context="{'group_by':'endpoint_id'}" />
        <filter name="group_by_status" string="By Status" context="{'group_by':'state'}" />
        <filter name="group_by_day" string="By Day" context="{'group_by':'create_date:day'}" />
        <filter name="group_by_company" string="By Company" context="{'group_by':'company_id'}" />
        <filter name="group_by_handler" string="By Handler" context="{'group_by':'handler_id'}" />
        <filter name="group_by_response" string="By HTTP Status" context="{'group_by':'response_status_code'}" />
        <filter name="group_by_latest_job_state" string="By Latest Job State" context="{'group_by':'latest_queue_job_state'}" />
      </search>
    </field>
  </record>

  <record id="view_webhook_outbound_delivery_pivot" model="ir.ui.view">
    <field name="name">webhook.outbound.delivery.pivot</field>
    <field name="model">bwt.webhook.outbound.delivery</field>
    <field name="arch" type="xml">
      <pivot string="Outbound Event Insights">
        <field name="endpoint_id" type="row" />
        <field name="state" type="col" />
        <field name="create_date" interval="day" type="col" />
        <field name="queue_to_done_seconds" type="measure" />
        <field name="end_to_end_seconds" type="measure" />
      </pivot>
    </field>
  </record>

  <record id="view_webhook_outbound_delivery_graph" model="ir.ui.view">
    <field name="name">webhook.outbound.delivery.graph</field>
    <field name="model">bwt.webhook.outbound.delivery</field>
    <field name="arch" type="xml">
      <graph string="Outbound Event Trends" type="bar" sample="1" stacked="True">
        <field name="create_date" interval="day" />
        <field name="state" />
      </graph>
    </field>
  </record>

  <record id="view_webhook_outbound_delivery_list" model="ir.ui.view">
    <field name="name">webhook.outbound.delivery.list</field>
    <field name="model">bwt.webhook.outbound.delivery</field>
    <field name="arch" type="xml">
      <list decoration-danger="state in ('error','dead_letter')" decoration-warning="state in ('queued','processing')" decoration-success="state == 'done'">
        <field name="create_date" string="Created" />
        <field name="endpoint_id" />
        <field name="company_id" />
        <field name="attempt_count" />
        <field name="replay_count" />
        <field name="state" />
        <field name="request_body_mode" />
        <field name="queue_job_count" string="Jobs" />
        <field name="latest_queue_job_state" string="Latest Job State" />
        <field name="response_status_code" />
        <field name="queue_to_done_seconds" optional="hide" />
        <field name="end_to_end_seconds" optional="hide" />
        <field name="queued_at" />
        <field name="processed_at" />
      </list>
    </field>
  </record>

  <record id="view_webhook_outbound_delivery_form" model="ir.ui.view">
    <field name="name">webhook.outbound.delivery.form</field>
    <field name="model">bwt.webhook.outbound.delivery</field>
    <field name="arch" type="xml">
      <form delete="false">
        <header>
          <button name="action_queue_delivery" type="object" string="Queue Delivery" class="oe_highlight" invisible="state not in ['draft', 'error']" />
          <button name="action_reset_to_draft" type="object" string="Reset To Draft" invisible="state not in ['error', 'dead_letter', 'canceled']" />
          <button name="action_create_replay_delivery" type="object" string="Create Replay" invisible="state in ['draft', 'queued', 'processing']" />
          <button name="action_cancel_delivery" type="object" string="Cancel" invisible="state not in ['draft', 'error']" />
          <field name="state" widget="statusbar" statusbar_visible="draft,queued,processing,done" options="{'clickable': 0}" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object" name="action_view_queue_jobs" icon="fa-tasks">
              <field name="queue_job_count" widget="statinfo" string="Jobs" />
            </button>
          </div>
          <group string="Context">
            <group>
              <field name="name" />
              <field name="endpoint_id" />
              <field name="company_id" />
              <field name="replayed_from_delivery_id" />
              <field name="handler_id" />
              <field name="matched_outbound_rule_id" readonly="1" />
            </group>
            <group>
              <field name="http_method" />
              <field name="request_body_mode" />
              <field name="target_url" widget="url" />
              <field name="timeout_seconds" />
              <field name="replay_count" readonly="1" />
              <field name="latest_queue_job_id" readonly="1" />
              <field name="latest_queue_job_state" readonly="1" />
              <field name="queued_at" />
              <field name="processed_at" />
            </group>
          </group>
          <notebook>
            <page string="Request">
              <group string="Runtime Request Snapshots">
                <group>
                  <field name="request_headers_json" widget="text" readonly="1" />
                </group>
                <group>
                  <field name="payload_json" widget="text" readonly="1" />
                </group>
              </group>
            </page>
            <page string="Context Lines">
              <field name="context_line_ids" nolabel="1" context="{'default_delivery_id': id}">
                <list editable="bottom">
                  <field name="sequence" />
                  <field name="active" />
                  <field name="key_name" />
                  <field name="source_kind" />
                  <field name="source_expression" />
                  <field name="literal_value" />
                </list>
                <form>
                  <sheet>
                    <group>
                      <group>
                        <field name="sequence" />
                        <field name="active" />
                        <field name="key_name" />
                      </group>
                      <group>
                        <field name="source_kind" />
                        <field name="source_expression" invisible="source_kind == 'literal'" />
                        <field name="literal_value" invisible="source_kind != 'literal'" widget="text" />
                      </group>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Response">
              <group>
                <field name="response_status_code" readonly="1" />
                <field name="response_headers_json" widget="text" readonly="1" />
                <field name="response_body" widget="text" readonly="1" />
              </group>
            </page>
            <page string="Attempts">
              <field name="attempt_ids" readonly="1">
                <list>
                  <field name="attempt_number" />
                  <field name="started_at" />
                  <field name="finished_at" />
                  <field name="state" />
                  <field name="http_method" />
                  <field name="request_body_mode" />
                  <field name="multipart_file_keys" />
                  <field name="target_url" />
                  <field name="response_status_code" />
                  <field name="processing_error" />
                </list>
              </field>
            </page>
            <page string="Replays">
              <field name="replay_delivery_ids" readonly="1">
                <list>
                  <field name="create_date" string="Created" />
                  <field name="name" />
                  <field name="state" />
                  <field name="response_status_code" />
                  <field name="processed_at" />
                </list>
              </field>
            </page>
            <page string="Processing">
              <group>
                <field name="matched_outbound_rule_id" readonly="1" />
                <field name="processing_note" readonly="1" />
                <field name="processing_error" readonly="1" />
                <field name="queue_job_identity_key" readonly="1" />
                <field name="latest_queue_job_id" readonly="1" />
                <field name="latest_queue_job_state" readonly="1" />
              </group>
            </page>
            <page string="Jobs">
              <field name="queue_job_ids" nolabel="1" readonly="1">
                <list>
                  <field name="date_created" />
                  <field name="name" />
                  <field name="uuid" />
                  <field name="state" />
                  <field name="retry" />
                  <field name="max_retries" />
                  <field name="date_done" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <record id="action_webhook_outbound_delivery" model="ir.actions.act_window">
    <field name="name">Outbound Events</field>
    <field name="res_model">bwt.webhook.outbound.delivery</field>
    <field name="view_mode">list,pivot,graph,form</field>
    <field name="search_view_id" ref="view_webhook_outbound_delivery_search" />
    <field name="context">{'search_default_not_done': 1, 'search_default_group_by_day': 1}</field>
  </record>

  <record id="action_webhook_outbound_delivery_reporting" model="ir.actions.act_window">
    <field name="name">Outbound Reporting</field>
    <field name="res_model">bwt.webhook.outbound.delivery</field>
    <field name="view_mode">pivot,graph,list</field>
    <field name="search_view_id" ref="view_webhook_outbound_delivery_search" />
    <field name="context">{'search_default_last_24_hours': 1, 'search_default_group_by_day': 1}</field>
  </record>
</odoo>
