<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_webhooks" model="ir.module.category">
        <field name="name">Webhooks</field>
        <field name="sequence">38</field>
    </record>

    <record id="res_groups_privilege_webhooks" model="res.groups.privilege">
        <field name="name">Webhooks</field>
        <field name="category_id" ref="webhooks.module_category_webhooks"/>
    </record>

    <record id="group_webhooks_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="privilege_id" ref="webhooks.res_groups_privilege_webhooks"/>
    </record>

    <record id="group_webhooks_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="webhooks.res_groups_privilege_webhooks"/>
        <field name="implied_ids" eval="[(4, ref('webhooks.group_webhooks_operator'))]"/>
    </record>

</odoo>