<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <data noupdate="1">
    <!-- Outbound loopback endpoint: drafts can be queued to the demo inbound orders endpoint for smoke tests. -->
    <record id="webhook_demo_outbound_endpoint_loopback_orders" model="bwt.webhook.outbound.endpoint">
      <field name="name">Demo Outbound Loopback Orders Endpoint</field>
      <field name="code">demo-outbound-loopback-orders</field>
      <field name="company_id" ref="base.main_company" />
      <field name="handler_id" ref="bwt_webhooks_core.webhook_demo_handler_outbound_loopback" />
      <field name="http_method">post</field>
      <field name="target_hostname">http://localhost:8069</field>
      <field name="target_path">/webhooks/in/demo-orders</field>
      <field name="note">Demo loopback outbound endpoint for smoke tests. Update the target hostname and path if your local Odoo server is not running on http://localhost:8069.</field>
    </record>

    <record id="webhook_demo_outbound_header_rule_source" model="bwt.webhook.outbound.endpoint.header.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">10</field>
      <field name="header_name">X-Demo-Source</field>
      <field name="source_kind">literal</field>
      <field name="literal_value">odoo-webhooks-demo</field>
    </record>

    <record id="webhook_demo_outbound_header_rule_delivery_id" model="bwt.webhook.outbound.endpoint.header.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">20</field>
      <field name="header_name">X-Delivery-Id</field>
      <field name="source_kind">context_key</field>
      <field name="source_expression">delivery_id</field>
    </record>

    <record id="webhook_demo_outbound_header_rule_topic" model="bwt.webhook.outbound.endpoint.header.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">30</field>
      <field name="header_name">X-Topic</field>
      <field name="source_kind">context_key</field>
      <field name="source_expression">topic</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_event_id" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">10</field>
      <field name="target_path">event_id</field>
      <field name="source_kind">context_key</field>
      <field name="source_expression">event_id</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_event_type" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">20</field>
      <field name="target_path">type</field>
      <field name="source_kind">context_key</field>
      <field name="source_expression">event_type</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_order_id" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">30</field>
      <field name="target_path">data.id</field>
      <field name="source_kind">context_key</field>
      <field name="source_expression">order_id</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_order_total" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">40</field>
      <field name="target_path">data.total</field>
      <field name="source_kind">context_key</field>
      <field name="source_expression">order_total</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_order_currency" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">50</field>
      <field name="target_path">data.currency</field>
      <field name="source_kind">context_key</field>
      <field name="source_expression">currency</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_order_customer" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">60</field>
      <field name="target_path">data.customer</field>
      <field name="source_kind">context_key</field>
      <field name="source_expression">customer</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_delivery_name" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">70</field>
      <field name="target_path">meta.delivery_name</field>
      <field name="source_kind">delivery_field</field>
      <field name="source_expression">name</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_endpoint_code" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">80</field>
      <field name="target_path">meta.source_endpoint</field>
      <field name="source_kind">endpoint_field</field>
      <field name="source_expression">code</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_company_name" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">90</field>
      <field name="target_path">meta.company</field>
      <field name="source_kind">company_field</field>
      <field name="source_expression">name</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_partner_name" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">100</field>
      <field name="target_path">meta.partner</field>
      <field name="source_kind">partner_field</field>
      <field name="source_expression">name</field>
    </record>

    <record id="webhook_demo_outbound_payload_rule_created_at" model="bwt.webhook.outbound.endpoint.payload.rule">
      <field name="endpoint_id" ref="webhook_demo_outbound_endpoint_loopback_orders" />
      <field name="sequence">110</field>
      <field name="target_path">meta.created_at</field>
      <field name="source_kind">delivery_field</field>
      <field name="source_expression">create_date</field>
    </record>
  </data>
</odoo>
