<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_webhook_endpoint_search" model="ir.ui.view">
    <field name="name">webhook.inbound.endpoint.search</field>
    <field name="model">bwt.webhook.inbound.endpoint</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="path" />
        <field name="state" />
        <field name="company_id" />
        <field name="handler_id" />
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
        <filter name="active" string="Active" domain="[('state', '=', 'active')]" />
        <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]" />
        <separator />
        <filter name="group_by_company" string="By Company" context="{'group_by':'company_id'}" />
        <filter name="group_by_handler" string="By Handler" context="{'group_by':'handler_id'}" />
        <filter name="group_by_status" string="By Status" context="{'group_by':'state'}" />
      </search>
    </field>
  </record>

  <record id="view_webhook_endpoint_list" model="ir.ui.view">
    <field name="name">webhook.inbound.endpoint.list</field>
    <field name="model">bwt.webhook.inbound.endpoint</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="path" />
        <field name="state" />
        <field name="company_id" />
        <field name="handler_id" />
        <field name="route_path" />
        <field name="inbound_event_count" string="Accepted" />
        <field name="rejected_event_count" string="Rejected" />
      </tree>
    </field>
  </record>

  <record id="view_webhook_endpoint_form" model="ir.ui.view">
    <field name="name">webhook.inbound.endpoint.form</field>
    <field name="model">bwt.webhook.inbound.endpoint</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_activate" type="object" string="Activate" class="oe_highlight" invisible="state != 'draft'" />
          <button name="action_set_draft" type="object" string="Move To Draft" invisible="state not in ['active', 'archived']" />
          <button name="action_archive" type="object" string="Archive" invisible="state == 'archived'" />
          <field name="state" widget="statusbar" statusbar_visible="draft,active" options="{'clickable': 0}" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object" name="action_view_inbound_events" icon="fa-cloud-download">
              <field name="inbound_event_count" widget="statinfo" string="Accepted" />
            </button>
            <button class="oe_stat_button" type="object" name="action_view_rejected_events" icon="fa-ban">
              <field name="rejected_event_count" widget="statinfo" string="Rejected" />
            </button>
          </div>
          <group string="Endpoint">
            <group>
              <field name="name" />
              <field name="path" readonly="id" />
              <field name="route_path" readonly="1" />
            </group>
            <group>
              <field name="payload_contract" />
            </group>
          </group>
          <group string="Scope">
            <group>
              <field name="company_id" />
            </group>
          </group>
          <group string="Handler And Identity">
            <group>
              <field name="handler_id" />
              <field name="delivery_identity_policy" />
              <field name="replay_identity_policy" />
            </group>
          </group>
          <notebook>
            <page string="Semantic Bindings">
              <field name="semantic_binding_ids" nolabel="1">
                <tree editable="bottom">
                  <field name="semantic_name" />
                  <field name="value_key" />
                  <field name="note" />
                </tree>
                <form>
                  <sheet>
                    <group>
                      <field name="semantic_name" />
                      <field name="value_key" />
                      <field name="note" />
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Value Resolution">
              <field name="source_ids" nolabel="1">
                <tree editable="bottom">
                  <field name="field_name" />
                  <field name="candidate_sequence" />
                  <field name="sequence" widget="handle" />
                  <field name="joiner" />
                  <field name="source_kind" />
                  <field name="header_name" invisible="source_kind not in ['header', 'header_param']" />
                  <field name="header_param_name" invisible="source_kind != 'header_param'" />
                  <field name="payload_path" invisible="source_kind != 'payload_path'" />
                  <field name="literal_value" invisible="source_kind != 'literal'" />
                  <field name="computed_method" invisible="source_kind != 'computed'" />
                  <field name="normalize_mode" />
                  <field name="hash_algorithm" />
                  <field name="required" />
                  <field name="active" />
                </tree>
                <form>
                  <sheet>
                    <group>
                      <group>
                        <field name="field_name" />
                        <field name="candidate_sequence" />
                        <field name="sequence" />
                        <field name="joiner" />
                        <field name="active" />
                        <field name="required" />
                      </group>
                      <group>
                        <field name="source_kind" />
                        <field name="header_name" invisible="source_kind not in ['header', 'header_param']" />
                        <field name="header_param_name" invisible="source_kind != 'header_param'" />
                        <field name="payload_path" invisible="source_kind != 'payload_path'" />
                        <field name="literal_value" invisible="source_kind != 'literal'" widget="text" />
                        <field name="computed_method" invisible="source_kind != 'computed'" />
                        <field name="normalize_mode" />
                        <field name="hash_algorithm" />
                        <field name="note" />
                      </group>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Signature">
              <group string="Verification">
                <field name="signature_verification_mode" />
                <field name="signature_secret" password="True" invisible="signature_verification_mode != 'hmac'" />
                <field name="signature_secondary_secret" password="True" invisible="signature_verification_mode != 'hmac'" />
                <field name="signature_digest_algorithm" invisible="signature_verification_mode != 'hmac'" />
                <field name="signature_encoding" invisible="signature_verification_mode != 'hmac'" />
                <field name="signature_prefix" invisible="signature_verification_mode != 'hmac'" />
              </group>
              <group string="Freshness" invisible="signature_verification_mode != 'hmac'">
                <field name="signature_timestamp_format" />
                <field name="signature_max_age_seconds" />
                <field name="signature_max_future_skew_seconds" />
              </group>
              <separator string="Message Assembly" invisible="signature_verification_mode != 'hmac'" />
              <group invisible="signature_verification_mode != 'hmac'">
                <field name="signature_message_joiner" />
              </group>
              <field name="signature_part_ids" nolabel="1" invisible="signature_verification_mode != 'hmac'">
                <tree editable="bottom">
                  <field name="sequence" widget="handle" />
                  <field name="source_kind" />
                  <field name="header_name" invisible="source_kind not in ['header', 'header_param']" />
                  <field name="header_param_name" invisible="source_kind != 'header_param'" />
                  <field name="payload_path" invisible="source_kind != 'payload_path'" />
                  <field name="literal_value" invisible="source_kind != 'literal'" />
                  <field name="computed_method" invisible="source_kind != 'computed'" />
                  <field name="required" />
                  <field name="active" />
                </tree>
                <form>
                  <sheet>
                    <group>
                      <group>
                        <field name="sequence" />
                        <field name="source_kind" />
                        <field name="required" />
                        <field name="active" />
                      </group>
                      <group>
                        <field name="header_name" invisible="source_kind not in ['header', 'header_param']" />
                        <field name="header_param_name" invisible="source_kind != 'header_param'" />
                        <field name="payload_path" invisible="source_kind != 'payload_path'" />
                        <field name="literal_value" invisible="source_kind != 'literal'" />
                        <field name="computed_method" invisible="source_kind != 'computed'" />
                      </group>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Accepted Events">
              <field name="inbound_event_ids" domain="[('state', '!=', 'rejected')]" readonly="1">
                <tree>
                  <field name="received_at" />
                  <field name="event_type" />
                  <field name="event_id" />
                  <field name="delivery_id" />
                  <field name="idempotency_key" />
                  <field name="delivery_identity_source" />
                  <field name="delivery_kind" />
                  <field name="handler_id" />
                  <field name="state" />
                </tree>
              </field>
            </page>
            <page string="Rejected Requests">
              <field name="inbound_event_ids" domain="[('state', '=', 'rejected')]" readonly="1">
                <tree>
                  <field name="received_at" />
                  <field name="event_type" />
                  <field name="event_id" />
                  <field name="delivery_id" />
                  <field name="rejection_category" />
                  <field name="state" />
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <record id="action_webhook_endpoint" model="ir.actions.act_window">
    <field name="name">Inbound Endpoints</field>
    <field name="res_model">bwt.webhook.inbound.endpoint</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_webhook_endpoint_search" />
  </record>
</odoo>
