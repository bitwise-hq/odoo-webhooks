<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_webhook_endpoint_search" model="ir.ui.view">
        <field name="name">webhook.endpoint.search</field>
        <field name="model">webhook.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="handler_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="paused" string="Paused" domain="[('is_paused', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_webhook_endpoint_list" model="ir.ui.view">
        <field name="name">webhook.endpoint.list</field>
        <field name="model">webhook.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="operational_state"/>
                <field name="company_id"/>
                <field name="handler_id"/>
                <field name="route_path"/>
                <field name="inbound_event_count" string="Accepted"/>
                <field name="rejected_event_count" string="Rejected"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_endpoint_form" model="ir.ui.view">
        <field name="name">webhook.endpoint.form</field>
        <field name="model">webhook.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_inbound_events" icon="fa-cloud-download">
                            <field name="inbound_event_count" widget="statinfo" string="Accepted"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_rejected_events" icon="fa-ban">
                            <field name="rejected_event_count" widget="statinfo" string="Rejected"/>
                        </button>
                    </div>
                    <group string="Endpoint">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="route_path" readonly="1"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="operational_state" readonly="1"/>
                            <field name="active"/>
                            <field name="is_paused"/>
                        </group>
                    </group>
                    <group string="Handler Resolution">
                        <group>
                            <field name="handler_id"/>
                            <field name="acceptance_key_policy"/>
                        </group>
                    </group>
                    <group string="Configuration Guidance" invisible="not configuration_warning">
                        <field name="configuration_warning" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Semantic Bindings">
                            <field name="semantic_binding_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="semantic_name"/>
                                    <field name="value_key"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Value Resolution">
                            <field name="source_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="field_name"/>
                                    <field name="candidate_sequence"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="joiner"/>
                                    <field name="source_kind"/>
                                    <field name="header_name" invisible="source_kind not in ['header', 'header_param']"/>
                                    <field name="header_param_name" invisible="source_kind != 'header_param'"/>
                                    <field name="payload_path" invisible="source_kind != 'payload_path'"/>
                                    <field name="literal_value" invisible="source_kind != 'literal'"/>
                                    <field name="computed_method" invisible="source_kind != 'computed'"/>
                                    <field name="normalize_mode"/>
                                    <field name="hash_algorithm"/>
                                    <field name="required"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Signature">
                            <group string="Verification">
                                <field name="signature_verification_mode"/>
                                <field name="signature_secret" password="True" invisible="signature_verification_mode != 'hmac'"/>
                                <field name="signature_secondary_secret" password="True" invisible="signature_verification_mode != 'hmac'"/>
                                <field name="signature_digest_algorithm" invisible="signature_verification_mode != 'hmac'"/>
                                <field name="signature_encoding" invisible="signature_verification_mode != 'hmac'"/>
                                <field name="signature_prefix" invisible="signature_verification_mode != 'hmac'"/>
                            </group>
                            <group string="Freshness" invisible="signature_verification_mode != 'hmac'">
                                <field name="signature_timestamp_format"/>
                                <field name="signature_max_age_seconds"/>
                                <field name="signature_max_future_skew_seconds"/>
                            </group>
                            <group string="Message Assembly" invisible="signature_verification_mode != 'hmac'">
                                <field name="signature_message_joiner"/>
                                <field name="signature_part_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="source_kind"/>
                                        <field name="header_name" invisible="source_kind not in ['header', 'header_param']"/>
                                        <field name="header_param_name" invisible="source_kind != 'header_param'"/>
                                        <field name="payload_path" invisible="source_kind != 'payload_path'"/>
                                        <field name="literal_value" invisible="source_kind != 'literal'"/>
                                        <field name="computed_method" invisible="source_kind != 'computed'"/>
                                        <field name="required"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Accepted Deliveries">
                            <field name="inbound_event_ids" domain="[('state', '!=', 'rejected')]" readonly="1">
                                <list>
                                    <field name="received_at"/>
                                    <field name="event_type"/>
                                    <field name="event_id"/>
                                    <field name="delivery_id"/>
                                    <field name="idempotency_key"/>
                                    <field name="accepted_identity_source"/>
                                    <field name="handler_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rejected Requests">
                            <field name="inbound_event_ids" domain="[('state', '=', 'rejected')]" readonly="1">
                                <list>
                                    <field name="received_at"/>
                                    <field name="event_type"/>
                                    <field name="event_id"/>
                                    <field name="delivery_id"/>
                                    <field name="rejection_category"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webhook_endpoint" model="ir.actions.act_window">
        <field name="name">Webhook Endpoints</field>
        <field name="res_model">webhook.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_webhook_endpoint_search"/>
    </record>

</odoo>